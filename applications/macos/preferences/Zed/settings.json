// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "agent": {
    "threads_sidebar": {
      "position": "right"
    },
    "dock": "right",
    "default_profile": "ask",
    "model_parameters": [],
  },
  "agent_servers": {
    "claude-acp": {
      "default_config_options": {
        "mode": "plan"
      },
      "type": "registry",
    },
  },
  "auto_indent_on_paste": false,
  "auto_install_extensions": {
    "colorizer": true,
    "dockerfile": true,
    "git-firefly": true,
    "html": true,
    "material-icon-theme": true,
    "php": true,
    "python": true,
    "sql": true,
    "toml": true,
    "vue": true,
  },
  "base_keymap": "Atom",
  "buffer_font_fallbacks": ["Monaco", "Courier New"],
  "buffer_font_family": "Cascadia Code",
  "buffer_font_size": 15,
  "cli_default_open_behavior": "new_window",
  "diff_view_style": "unified",
  "edit_predictions": {
    "allow_data_collection": "no",
    "mode": "subtle",
  },
  "ensure_final_newline_on_save": true,
  "file_types": {
    "sql": ["*.sql"],
  },
  "git_panel": {
    "group_by": "status",
    "tree_view": false,
    "dock": "left",
  },
  "gutter": {
    "min_line_number_digits": 2,
  },
  "hard_tabs": false,
  "icon_theme": "Material Icon Theme",
  "languages": {
    "Dockerfile": {
      "wrap_guides": [],
    },
    "Git Commit": {
      "wrap_guides": [50, 70],
    },
    "JavaScript": {
      "format_on_save": "on",
      "tab_size": 2,
    },
    "JSON": {
      "wrap_guides": [],
    },
    "JSONC": {
      "wrap_guides": [],
    },
    "Markdown": {
      "remove_trailing_whitespace_on_save": false,
      "tab_size": 4,
    },
    "PHP": {
      "format_on_save": "on",
      "formatter": {
        "external": {
          "command": "/Users/ruudwelten/.dotfiles/global/php/php-cs-fixer-stdin",
          "arguments": ["-"],
        },
      },
      "language_servers": ["intelephense", "!phpactor"],
    },
    "Python": {
      "formatter": {
        "external": {
          "command": "autopep8",
          "arguments": ["-"],
        },
      },
      "tab_size": 4,
      "wrap_guides": [79],
    },
    "TOML": {
      "wrap_guides": [],
    },
    "TypeScript": {
      "tab_size": 2,
    },
    "Vue.js": {
      "format_on_save": "on",
      "tab_size": 2,
    },
    "YAML": {
      "wrap_guides": [],
    },
  },
  "minimap": {
    "show": "never",
  },
  "profiles": {
    "Clean": {
      "settings": {
        "buffer_line_height": {
          "custom": 1.8,
        },
        "gutter": {
          "breakpoints": false,
          "folds": false,
          "min_line_number_digits": 0,
          "line_numbers": false,
          "runnables": false,
        },
        "icon_theme": "Zed (Default)",
        "indent_guides": {
          "enabled": false,
        },
        "outline_panel": {
          "button": true,
        },
        "theme": "Ayu Dark",
      },
    },
  },
  "project_panel": {
    "dock": "left",
  },
  "remove_trailing_whitespace_on_save": true,
  "show_edit_predictions": true,
  "telemetry": {
    "diagnostics": false,
    "metrics": false,
  },
  "terminal": {
    "line_height": {
      "custom": 1.4,
    },
  },
  "theme": {
    "mode": "dark",
    "light": "Ayu Light",
    "dark": "Colorizer Pro",
  },
  "theme_overrides": {
    "Colorizer Pro": {
      "created.background": "#144028",
      "editor.subheader.background": "#08090a99",
      "editor.document_highlight.read_background": "#135d7966",
      "editor.document_highlight.bracket_background": "#94205866",
      "search.match_background": "#14513d",
      "syntax": {
        "property": {
          "color": "#5fd8ae",
        },
      },
      "players": [
        {
          "selection": "#383e54",
        },
      ],
    },
  },
  "ui_font_size": 16,
  "wrap_guides": [80, 120],
}
