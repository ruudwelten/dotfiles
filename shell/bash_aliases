#!/usr/bin/env bash

alias ..="cd .."
alias ...="cd ../.."
alias ....="cd ../../.."
alias cd..="cd .."

alias dev="cd ~/Development"
alias dot="cd ~/.dotfiles"

alias tim="~/.tim/tim.py"
alias act="[[ -f \"venv/bin/activate\" ]] && source venv/bin/activate && print_in_green \"Activating virtual environment in \\\`venv\\\`\\n\\n\" || [[ -f \".venv/bin/activate\" ]] && source .venv/bin/activate && print_in_green \"Activating virtual environment in \\\`.venv\\\`\\n\\n\" || print_in_red \"Your virtual environment can not be found.\\n\\n\""
alias ip="curl icanhazip.com"

python () {
    if [[ "$1" == "-v" && $# -eq 1 ]]; then
        command python -V
    elif [[ "$1" == "--verbose" && $# -eq 1 ]]; then
        command python -v
    else
        command python "$@"
    fi
}
